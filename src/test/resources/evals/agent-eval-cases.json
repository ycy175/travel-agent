      "mustNotContain": [
        "userId",
        "user_id",
        "level",
        "employeeLevel",
        "sessionId",
        "approverId"
      ]
    },
    {
      "id": "S02",
      "type": "SCHEMA_SAFETY",
      "description": "book_travel 不得暴露身份字段",
