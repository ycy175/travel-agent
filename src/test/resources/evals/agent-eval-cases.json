      "mustNotContain": [
        "userId",
        "user_id",
        "level",
        "employeeLevel",
        "sessionId"
      ]
    },
    {
      "id": "S03",
      "type": "SCHEMA_SAFETY",
      "description": "query_travel_policy 不得暴露职级参数",
      "tool": "query_travel_policy",
      "mustNotContain": [
        "level",
        "employeeLevel",
        "userId"
      ]
    },
    {
      "id": "S04",
      "type": "SCHEMA_SAFETY",
      "description": "所有工具 schema 必须包含业务参数",
      "tool": "submit_travel_approval",
      "mustContain": [
        "itinerary",
        "cost"
